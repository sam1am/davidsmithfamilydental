---
layout: layouts/base.njk
title: Our Services
---

<div class="pt-20 pb-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <h1 class="text-4xl font-bold text-center mb-8">Our Services</h1>

  {# Group services by section #}
  {% set sections = services.services | groupBy("section") %}
  
  {% for sectionName, sectionServices in sections %}
    <div class="mb-12 last:mb-0">
      <h2 class="text-3xl font-semibold mb-6 text-center">{{ sectionName }}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {% for service in sectionServices %}
          <div class="bg-white rounded-lg shadow-sm overflow-hidden group hover:shadow-lg transition-all duration-300">
            <a href="{{ service.article }}" class="block p-4">
              <div class="flex gap-4">
                <div class="relative w-28 h-28 flex-shrink-0 overflow-hidden">
                  <img src="{{ service.image }}" alt="{{ service.name }}" 
                       class="w-full h-full object-cover rounded-lg transform group-hover:scale-105 transition-transform duration-300">
                  <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
                </div>
                <div class="flex-grow">
                  <h3 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors duration-300 mb-2">
                    {{ service.name }}
                  </h3>
                  <div class="h-10 overflow-hidden group-hover:h-auto transition-all duration-300">
                    <p class="text-sm text-gray-600">{{ service.description }}</p>
                  </div>
                  <span class="inline-block mt-2 text-sm text-blue-600 group-hover:text-blue-800">
                    Learn More →
                  </span>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
