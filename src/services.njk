---
layout: layouts/base.njk
title: Our Services
---

<div class="bg-gray-900 w-full mb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-white text-center mb-8">Our Services</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Comprehensive dental care for your entire family, from routine cleanings to advanced procedures
      </p>
    </div>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {% set sections = ['General Dentistry', 'Cosmetic Services', 'Specialty Dentistry'] %}
    
    {% for section in sections %}
    <div class="mb-16 last:mb-0">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">{{ section }}</h2>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {% for service in services.services %}
        {% if service.section == section %}
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          {% if service.article %}
          <a href="{{ service.article }}" class="block">
            <div class="relative h-48">
              <img class="w-full h-full object-cover" src="{{ service.image }}" alt="{{ service.name }}">
            </div>
            <div class="p-6 pb-0">
              <h3 class="text-xl font-semibold text-gray-900 hover:text-blue-600">{{ service.name }}</h3>
            </div>
          </a>
          {% else %}
          <div class="relative h-48">
            <img class="w-full h-full object-cover" src="{{ service.image }}" alt="{{ service.name }}">
          </div>
          <div class="p-6 pb-0">
            <h3 class="text-xl font-semibold text-gray-900">{{ service.name }}</h3>
          </div>
          {% endif %}
          <div class="p-6 pt-2">
            <p class="mt-2 text-gray-600">{{ service.description }}</p>
            {% if service.article %}
            <a href="{{ service.article }}" class="inline-block mt-4 text-blue-600 hover:text-blue-800">Learn More →</a>
            {% endif %}
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>
