---
layout: layouts/base.njk
title: Our Services
---

<div class="pt-24 pb-16 max-w-7xl mx-auto px-4">
  <h1 class="text-4xl font-bold text-center mb-12">Our Services</h1>

  {# Group services by section #}
  {% set sections = services.services | groupBy("section") %}
  
  {% for sectionName, sectionServices in sections %}
    <div class="mb-16">
      <h2 class="text-3xl font-semibold mb-8">{{ sectionName }}</h2>
      <div class="space-y-8">
        {% for service in sectionServices %}
          <div class="flex flex-col md:flex-row gap-6 bg-white rounded-lg shadow-md overflow-hidden">
            <div class="md:w-1/3">
              <img src="{{ service.image }}" alt="{{ service.name }}" class="w-full h-64 object-cover">
            </div>
            <div class="md:w-2/3 p-6">
              <h3 class="text-2xl font-semibold mb-3">{{ service.name }}</h3>
              <p class="text-gray-600 mb-4">{{ service.description }}</p>
              <a href="{{ service.article }}" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition duration-300">
                Learn More
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
