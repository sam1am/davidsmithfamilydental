<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% if description %}{{ description }}{% else %}David Smith Family Dental provides complete family dental care in Salt Lake City. Modern, anxiety-free dentistry for all ages. Schedule your appointment today.{% endif %}">
    <meta name="keywords" content="dentist salt lake city, family dentist, dental care, cosmetic dentistry, emergency dentist, dental implants, teeth whitening, orthodontics">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://davidsmithfamilydental.com{{ page.url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}David Smith Family Dental provides complete family dental care in Salt Lake City. Modern, anxiety-free dentistry for all ages.{% endif %}">
    <meta property="og:image" content="https://davidsmithfamilydental.com/assets/images/office_exterior.jpg">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://davidsmithfamilydental.com{{ page.url }}">
    <meta property="twitter:title" content="{{ title }}">
    <meta property="twitter:description" content="{% if description %}{{ description }}{% else %}David Smith Family Dental provides complete family dental care in Salt Lake City. Modern, anxiety-free dentistry for all ages.{% endif %}">
    <meta property="twitter:image" content="https://davidsmithfamilydental.com/assets/images/office_exterior.jpg">

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <title>{{ title }}{% if not page.url === "/" %} | David Smith Family Dental{% endif %}</title>
    <link href="/assets/css/tailwind.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#007bff',
                    },
                    typography: {
                        DEFAULT: {
                            css: {
                                'h1, h2, h3, h4': {
                                    color: '#1a202c',
                                },
                                ul: {
                                    'list-style-type': 'disc',
                                },
                                li: {
                                    '&::marker': {
                                        color: '#007bff',
                                    },
                                },
                                a: {
                                    color: '#007bff',
                                    '&:hover': {
                                        color: '#0056b3',
                                    },
                                },
                            },
                        },
                    },
                },
            },
        }
    </script>
</head>
