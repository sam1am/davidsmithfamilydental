<div class="bg-gray-50 relative">
  <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8 mb-0">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Our Services</h2>
      <p class="mt-4 text-lg text-gray-500">Comprehensive dental care for your entire family</p>
    </div>

    {% set sections = services.services | groupBy("section") %}
    
    {% for sectionName, sectionServices in sections %}
      <div class="mb-12 last:mb-0">
        <h2 class="text-3xl font-semibold mb-6 text-center">{{ sectionName }}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for service in sectionServices %}
            <div class="bg-blue-50 rounded-lg shadow-sm overflow-hidden group hover:shadow-xl transition-all duration-300">
              <a href="{{ service.article }}" class="block p-5">
                <div class="flex gap-4">
                  <div class="relative w-28 h-28 flex-shrink-0 overflow-hidden">
                    <img src="{{ service.image }}" alt="{{ service.name }}" 
                         class="w-full h-full object-cover rounded-lg transform group-hover:scale-105 transition-transform duration-300">
                    <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
                  </div>
                  <div class="flex-grow">
                    <h3 class="text-2xl font-bold text-gray-800 group-hover:text-blue-800 transition-colors duration-300 mb-1 min-h-[2.75rem]">
                      {{ service.name }}
                    </h3>
                    <div class="h-[3.75rem] overflow-hidden">
                      <p class="text-sm text-gray-800">{{ service.description }}</p>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
